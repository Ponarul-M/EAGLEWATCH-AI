# Copy this file to .env and adjust as needed.

# SQLite database file (relative to backend/ folder)
DATABASE_URL=sqlite:///./eaglewatch.db

# Comma-separated list of allowed CORS origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# AI pipeline
# ---------------------------------------------------------------------

# "real" = YOLO + ByteTrack pipeline, "demo" = canned scenario system.
# Keep this on "demo" as your safety net for the hackathon stage -
# switch to "real" once you've confirmed the pipeline works locally.
AI_MODE=real

# Lightweight YOLO model - good default for a hackathon laptop (CPU or GPU).
YOLO_MODEL=yolo11n.pt
CONFIDENCE_THRESHOLD=0.40
TRACKER_CONFIG=bytetrack.yaml

# How many recent points to keep per tracked object (memory control)
TRACK_HISTORY_LENGTH=60

# Consecutive confirming frames required before an event fires
EVENT_CONFIRM_FRAMES=5

# Duplicate-incident suppression window (seconds) per camera+event type
EVENT_COOLDOWN_SECONDS=30

# --- Stage 1: pre-accident risk prediction (services/risk_predictor.py) ---
# Consecutive confirming frames required before a risk level (e.g.
# HIGH_RISK) is reported as sustained - deliberately shorter than
# EVENT_CONFIRM_FRAMES so the warning appears before the confirmation.
RISK_CONFIRM_FRAMES=4
# How far into the future (seconds) a projected closest-approach still
# counts as a meaningful warning.
TTC_HORIZON_SECONDS=4.0
# Projected closest-approach distance (pixels) below which two objects
# are considered on a collision course. This is in image pixel space -
# it implicitly depends on camera distance/zoom/resolution, so tune it
# per camera/video. Too low = warnings arrive too late; too high = more
# false positives on merely-nearby traffic.
COLLISION_DISTANCE_PX=80.0
# Minimum relative closing speed (px/s) before two objects are even
# considered "approaching" - filters out near-stationary noise.
MIN_CLOSING_SPEED_PX_S=15.0

# 0 = webcam, or an absolute/relative path to a video file
VIDEO_SOURCE=sample_video/car_accident.mp4
CAMERA_ID=CAM-01
CAMERA_LOCATION=Anna Salai & Mount Road
CAMERA_X=65
CAMERA_Y=42

# Worker loop pacing / logging
AI_TARGET_FPS=12
AI_LOG_EVERY_N_FRAMES=150
